{
  "_warning": "NUNCA preencher chaves reais neste arquivo enquanto ele estiver dentro do repositorio. Copie este template para FORA do repo (ou para o arquivo local da IDE em %USERPROFILE%\\.claude, %APPDATA%\\Code\\User, etc.) ANTES de substituir os placeholders <SUA_CHAVE_*>.",
  "_uso": "MCPs externos opcionais. Use junto com mcp.brain-only.template.json no mesmo arquivo final da sua IDE (mesclando os blocos dentro de mcpServers).",
  "mcpServers": {
    "StitchMCP": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://stitch.googleapis.com/mcp",
        "--header",
        "X-Goog-Api-Key: <SUA_GOOGLE_API_KEY_AQUI>"
      ],
      "env": {}
    },
    "notion-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "env": {
        "OPENAPI_MCP_HEADERS": "{\"Authorization\": \"Bearer <SUA_CHAVE_NOTION_AQUI>\", \"Notion-Version\": \"2022-06-28\"}"
      }
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.supabase.com/mcp?project_ref=<SEU_SUPABASE_PROJECT_REF_AQUI>"
      ],
      "env": {}
    },
    "postman-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "@postman/postman-mcp-server"
      ],
      "env": {
        "POSTMAN_API_KEY": "<SUA_CHAVE_POSTMAN_AQUI>"
      }
    }
  }
}
